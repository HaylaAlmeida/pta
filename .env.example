# ==========================================
# Configurações do Servidor PTA (Exemplo)
# ==========================================

# Configurações de Rede
PTA_HOST=0.0.0.0
PTA_PORT=11550
PTA_BUFFER_SIZE=2048
PTA_BACKLOG=128
PTA_MAX_MESSAGE_SIZE=65536
PTA_ENCODING=ascii

# Controles de Concorrência e Resiliência
PTA_MAX_WORKERS=10
PTA_SOCKET_TIMEOUT=30.0

# Observabilidade e Logs
PTA_LOG_LEVEL=INFO
PTA_LOG_JSON=false

# Caminhos Customizados
# PTA_USERS_FILE=/app/users.txt
# PTA_FILES_DIR=/app/files
